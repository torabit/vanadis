#!/bin/sh
# btop reads its theme once, at startup, and has no reload signal. Quitting it returns
# the pane to the shell that launched it, and running it again picks the theme back up.
#
# Two calls, so `reload` in config.toml cannot hold them: it is an argv and runs no shell.
#
# `--session` is required, not stylistic. See the header of demo/vanadis/config.toml.
# `demo-env` is required for the same reason it is required at startup: the pane's shell is
# the recorder's, and it has put its own XDG_CONFIG_HOME back.
set -eu
pane=$1
herdr --session vanadis-demo pane send-keys "$pane" q >/dev/null
herdr --session vanadis-demo pane run "$pane" demo/bin/demo-env btop >/dev/null
