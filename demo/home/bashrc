# The shell the demo's prompt pane runs, so no part of the recorder's own bashrc shows up
# in the frame. starship re-reads its config on every prompt, which is why this pane
# follows a theme with no reload command anywhere.
#
# Panes inherit their cwd from the pane they were split off, which the tape leaves at the
# repository root.

export COLORTERM=truecolor
export VANADIS_CONFIG="$PWD/demo/vanadis"
export XDG_CONFIG_HOME="$PWD/demo/home"
export STARSHIP_CONFIG="$PWD/demo/home/starship.toml"
export HERDR_CONFIG_PATH="$PWD/demo/home/herdr/config.toml"

export PS1='$ '
eval "$(starship init bash)"
