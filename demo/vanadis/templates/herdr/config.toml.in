# Generated by vanadis. Edit templates/herdr/config.toml.in.
#
# herdr reloads this in the running server on `herdr server reload-config`, so the
# sidebar, the tab bar, the pane borders and the pane backgrounds all change without
# anything restarting. It is the only target here that needs no trick at all beyond
# telling it to look again.
#
# herdr 0.8 shipped in 2026 and has no base16 template repository. Nothing but this file
# was needed to theme it.

[theme]
# The base is a built-in of the right lightness, named by the theme in `text.herdr-base`.
# Every token below overrides it, and the base is what catches any this file has missed:
# get it wrong and a stray token draws a light pane border across a dark frame.
name = "{{text.herdr-base}}"

[theme.custom]
accent = "{{role.accent}}"
panel_bg = "{{role.bg}}"
sidebar_bg = "{{role.bg}}"
active_row_bg = "{{role.hover-bg}}"
selection_bg = "{{role.selection-bg}}"
surface0 = "{{role.hover-bg}}"
surface1 = "{{role.border}}"
surface_dim = "{{role.bg}}"
overlay0 = "{{role.comment}}"
overlay1 = "{{role.border}}"
text = "{{role.fg}}"
subtext0 = "{{role.comment}}"
mauve = "{{role.keyword}}"
green = "{{role.ok}}"
yellow = "{{role.warn}}"
red = "{{role.error}}"
blue = "{{role.visual}}"
teal = "{{role.accent-alt}}"
peach = "{{role.accent-warm}}"

# This is the whole set herdr accepts. `herdr config check` names any key that is not in it
# and then ignores it, so a token invented here is silent at runtime and loud only there.

[ui]
accent = "{{role.accent}}"
window_title = "vanadis demo"

[server]
# The size the headless server lays out at before a client attaches, so the panes the
# tape creates are already the shape the recording wants.
headless_cols = 150
headless_rows = 40

[experimental]
# vhs is launched from a shell, and on this machine that shell is itself a herdr pane.
# Without this the recording's herdr refuses to start: nested herdr is off by default.
allow_nested = true
