-- Generated by vanadis. Edit templates/nvim/vanadis.lua.in.
--
-- A running nvim re-executes this file on `:colorscheme vanadis`, which is what the
-- target's reload command sends to the pane. No restart.

vim.cmd("highlight clear")
if vim.fn.exists("syntax_on") == 1 then
  vim.cmd("syntax reset")
end

vim.o.termguicolors = true
vim.o.background = "{{meta.variant}}"
vim.g.colors_name = "vanadis"

local p = {
  bg = "{{role.bg}}",
  fg = "{{role.fg}}",
  comment = "{{role.comment}}",
  keyword = "{{role.keyword}}",
  string = "{{role.string}}",
  error = "{{role.error}}",
  ok = "{{role.ok}}",
  warn = "{{role.warn}}",
  visual = "{{role.visual}}",
  linenr = "{{role.linenr}}",
  accent = "{{role.accent}}",
  accent_alt = "{{role.accent-alt}}",
  accent_warm = "{{role.accent-warm}}",
  inactive = "{{role.inactive}}",
  border = "{{role.border}}",
  selection = "{{role.selection-bg}}",
  hover = "{{role.hover-bg}}",
}

local groups = {
  Normal = { fg = p.fg, bg = p.bg },
  NormalFloat = { fg = p.fg, bg = p.hover },
  FloatBorder = { fg = p.border, bg = p.hover },
  Cursor = { fg = p.bg, bg = p.accent },
  CursorLine = { bg = p.hover },
  CursorLineNr = { fg = p.accent, bold = true },
  LineNr = { fg = p.linenr },
  SignColumn = { bg = p.bg },
  ColorColumn = { bg = p.hover },
  VertSplit = { fg = p.border },
  WinSeparator = { fg = p.border },
  Visual = { bg = p.selection },
  Search = { fg = p.bg, bg = p.visual },
  IncSearch = { fg = p.bg, bg = p.accent },
  MatchParen = { fg = p.accent, bold = true },
  Pmenu = { fg = p.fg, bg = p.hover },
  PmenuSel = { fg = p.fg, bg = p.selection },
  StatusLine = { fg = p.fg, bg = p.hover },
  StatusLineNC = { fg = p.inactive, bg = p.hover },
  NonText = { fg = p.border },
  Folded = { fg = p.comment, bg = p.hover },

  Comment = { fg = p.comment, italic = true },
  Constant = { fg = p.accent_warm },
  String = { fg = p.string },
  Character = { fg = p.string },
  Number = { fg = p.accent_warm },
  Boolean = { fg = p.accent_warm },
  Identifier = { fg = p.fg },
  Function = { fg = p.accent },
  Statement = { fg = p.keyword },
  Keyword = { fg = p.keyword },
  Operator = { fg = p.accent_alt },
  PreProc = { fg = p.accent_alt },
  Type = { fg = p.accent_alt },
  Special = { fg = p.accent },
  Delimiter = { fg = p.comment },
  Title = { fg = p.accent, bold = true },
  Underlined = { fg = p.visual, underline = true },
  Todo = { fg = p.bg, bg = p.warn, bold = true },
  Error = { fg = p.error },
  ErrorMsg = { fg = p.error },
  WarningMsg = { fg = p.warn },
  DiagnosticError = { fg = p.error },
  DiagnosticWarn = { fg = p.warn },
  DiagnosticInfo = { fg = p.visual },
  DiagnosticHint = { fg = p.comment },
  DiffAdd = { fg = p.ok },
  DiffDelete = { fg = p.error },
  DiffChange = { fg = p.warn },
  DiffText = { fg = p.accent },

  ["@property"] = { fg = p.fg },
  ["@punctuation.bracket"] = { fg = p.comment },
  ["@punctuation.delimiter"] = { fg = p.comment },
  ["@string"] = { fg = p.string },
  ["@number"] = { fg = p.accent_warm },
  ["@boolean"] = { fg = p.accent_warm },
  ["@comment"] = { fg = p.comment, italic = true },
  ["@type"] = { fg = p.accent_alt },
  ["@keyword"] = { fg = p.keyword },
  ["@function"] = { fg = p.accent },
  ["@variable"] = { fg = p.fg },
  ["@constant"] = { fg = p.accent_warm },
  ["@label"] = { fg = p.accent, bold = true },
}

for name, spec in pairs(groups) do
  vim.api.nvim_set_hl(0, name, spec)
end
