# Generated by vanadis. Edit templates/starship/starship.toml.in.
#
# starship re-reads this on every prompt, so the prompt is themed the moment the file is
# written. No reload command exists for it because none is needed.

"$schema" = 'https://starship.rs/config-schema.json'

format = """
$directory\
$git_branch\
$git_status\
$cmd_duration\
$character"""

add_newline = false
palette = "vanadis"

[palettes.vanadis]
accent = "{{role.accent}}"
accent-alt = "{{role.accent-alt}}"
accent-warm = "{{role.accent-warm}}"
comment = "{{role.comment}}"
error = "{{role.error}}"
ok = "{{role.ok}}"
visual = "{{role.visual}}"

[directory]
style = "visual bold"
format = "[$path]($style) "
truncation_length = 2
truncate_to_repo = false

[git_branch]
format = "[$branch]($style) "
style = "comment"

[git_status]
format = "[$all_status$ahead_behind]($style)"
style = "accent-warm"

[cmd_duration]
format = "[$duration]($style) "
style = "accent-alt"

[character]
success_symbol = "[❯](accent)"
error_symbol = "[❯](error)"
