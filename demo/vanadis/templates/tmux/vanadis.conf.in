# Generated by vanadis. Edit templates/tmux/vanadis.conf.in.
#
# Sourced live: `tmux source-file` redraws every pane, so this file is what makes the
# whole frame change and not just the programs inside it.

set -g default-terminal "tmux-256color"
set -ga terminal-overrides ",*:Tc"

# Painting both styles is what fills the frame. Without them tmux leaves the terminal's
# own background showing through, which no theme can reach.
set -g window-style        "bg={{role.bg}},fg={{role.fg}}"
set -g window-active-style "bg={{role.bg}},fg={{role.fg}}"

set -g pane-border-style        "fg={{role.border}}"
set -g pane-active-border-style "fg={{role.accent}}"

set -g status on
set -g status-position top
set -g status-style "bg={{role.hover-bg}},fg={{role.fg}}"
set -g status-left  "#[fg={{role.accent}},bold] vanadis #[default]"
set -g status-left-length 20
set -g status-right "#[fg={{role.comment}}]{{meta.name}} #[fg={{role.border}}]│#[fg={{role.accent-alt}}] {{meta.variant}} "
set -g status-right-length 40

set -g window-status-current-style "fg={{role.accent}},bold"
set -g window-status-style         "fg={{role.inactive}}"

set -g message-style "bg={{role.selection-bg}},fg={{role.fg}}"
set -g mode-style    "bg={{role.selection-bg}},fg={{role.fg}}"
