# 生成物。編集は config.env.in を直す。

# tmux-thumbs の @thumbs-* をここへ移植した。起動キーは config.toml の
# [[keys.command]] (prefix+space) で張る。

# hint を大文字で選ぶと開く (alacritty の hints と同じ体験)
THUMBS_UPCASE=open

# 配色も alacritty の hints に合わせる。match は青地、jump prefix は赤地
THUMBS_FG_COLOR={{role.bg}}
THUMBS_BG_COLOR={{role.visual}}
THUMBS_HINT_FG_COLOR={{role.bg}}
THUMBS_HINT_BG_COLOR={{role.error}}
THUMBS_SELECT_FG_COLOR={{role.bg}}
THUMBS_SELECT_BG_COLOR={{role.accent}}
